{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criamundo-site",
  "main": "./worker.js",
  "compatibility_date": "2026-05-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "criamundo-content",
      "database_id": "c77ffa05-5314-453b-83f7-eefc24b4e43b"
    }
  ]
}
